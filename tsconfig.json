{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"types": ["$app/types", "unplugin-icons/types/svelte"]
	},
	"exclude": [
		"src/tools/**/*.js",
		"*.js",
		"benchmark-point-in-polygon.js",
		"regenerate-index.js",
		"test-*.js"
	],
	"include": [
		"src",
		"vite.config.ts",
		"sveltekit.options.ts",
		"drizzle.config.ts",
		"playwright.config.ts"
	]
}
